PORT=5000
NODE_ENV=development

# CORS origin (default: http://localhost:3000)
CORS_ORIGIN=http://localhost:3000

# Google Apps Script Web App URL (handles all Sheets + Drive operations)
GAS_SHEETS_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# GAS OTP Email URL (leave empty to use dev-console fallback that logs OTP to terminal)
GAS_SEND_OTP_URL=

# Session (REQUIRED in production — server will refuse to start without it)
SESSION_SECRET=change-this-to-a-random-string-in-production

# ── Feature 3: event follow-up (survey) ────────────────────────────────────
# Approved ZNS follow-up/survey template id (StudyLink OA: "Khảo sát ý kiến sự
# kiện StudyLink - Chưa Tham Gia"). Leave empty to keep the Zalo follow-up
# DORMANT. The Zalo half needs only this + your existing ZALO_OA_* creds.
ZALO_ZNS_FOLLOWUP_TEMPLATE_ID=611671

# Email backup (Resend). Leave RESEND_API_KEY empty to keep the email backup
# off; the Zalo send still works. RESEND_FROM must be a verified sender.
RESEND_API_KEY=
RESEND_FROM=StudyLink <info@studylink.org>

# The survey link the follow-up email's button opens (defaults to the no-show
# Google Form baked into template 611671 if left empty).
EVENT_FOLLOWUP_SURVEY_URL=

# Optional: customer-facing event label used in the follow-up EMAIL body
# (the Zalo template has its own fixed wording). Falls back to the event's
# name if empty — set this to a Vietnamese label if the internal event name
# (e.g. "Fair First Date 18.7.2026") shouldn't show to recipients.
EVENT_FOLLOWUP_EVENT_LABEL=
